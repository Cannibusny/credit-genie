# --- Credit Genie (required) ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3001

# --- LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Control Plane (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OCR Engine ---
# Tesseract.js runs locally; no external key needed.
# For production, consider Google Document AI or AWS Textract:
# GOOGLE_DOCUMENT_AI_KEY=
# AWS_TEXTRACT_ACCESS_KEY=
# AWS_TEXTRACT_SECRET_KEY=

# --- Open Banking (Plaid) — Engine 3 ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Pipeline Tuning ---
MAX_REPORT_SIZE_MB=25
DISPUTE_RESPONSE_DEADLINE_DAYS=30
