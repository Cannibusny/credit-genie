{
  "name": "credit-genie",
  "version": "0.1.0",
  "description": "Legal Intelligence System for credit repair — Metro 2 compliance auditor, automated litigator, and credit builder.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
